{
  "name": "rafters-mail-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vp test run --config vitest.config.ts",
    "test:spec": "vp test run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:spec && pnpm test:e2e",
    "test:watch": "vp test watch --config vitest.config.ts",
    "test:coverage": "vp test run --config vitest.config.ts --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@rafters/toolchain": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "playwright": "^1.58.2",
    "tsup": "^8.5.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=12.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
