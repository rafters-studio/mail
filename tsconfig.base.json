{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,

    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@rafters/mail/message": ["./packages/core/src/message/index.ts"],
      "@rafters/mail/document": ["./packages/core/src/document/index.ts"],
      "@rafters/mail/address": ["./packages/core/src/address/index.ts"],
      "@rafters/mail/message-id": ["./packages/core/src/message-id/index.ts"],
      "@rafters/mail/receive": ["./packages/core/src/receive/index.ts"],
      "@rafters/mail/masked": ["./packages/core/src/masked/index.ts"],
      "@rafters/mail/read": ["./packages/core/src/read/index.ts"],
      "@rafters/mail/imap": ["./packages/core/src/imap/index.ts"],
      "@rafters/mail-cloudflare": ["./packages/cloudflare/src/index.ts"],
      "@rafters/mail-react-email": ["./packages/react-email/src/index.ts"],
      "@rafters/mail-react-email/*": ["./packages/react-email/src/*"]
    },

    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules", "coverage"]
}
