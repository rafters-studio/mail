{
  "name": "@rafters/mail",
  "version": "0.2.0",
  "description": "Writes email messages as exact bytes every client reads: addresses, Message-IDs, documents and MIME.",
  "homepage": "https://github.com/rafters-studio/mail/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/mail/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/mail.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./message": "./dist/message/index.js",
    "./document": "./dist/document/index.js",
    "./address": "./dist/address/index.js",
    "./message-id": "./dist/message-id/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rafters/mail-test-readers": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "4.1.0",
    "esbuild": "0.25.10",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
