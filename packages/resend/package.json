{
  "name": "@rafters/mail-resend",
  "version": "0.2.0",
  "description": "Send mail for @rafters/mail through Resend",
  "homepage": "https://github.com/rafters-studio/mail/tree/main/packages/resend#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/mail/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/mail.git",
    "directory": "packages/resend"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vp test run --config vitest.config.ts",
    "test:watch": "vp test watch --config vitest.config.ts",
    "test:coverage": "vp test run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rafters/mail": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
