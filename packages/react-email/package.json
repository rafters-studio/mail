  },
  "devDependencies": {
    "@rafters/mail-test-readers": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
