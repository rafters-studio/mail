{
  "name": "@rafters/mail-react-email",
  "version": "0.2.0",
  "description": "React Email templates rendered as { html, text } for @rafters/mail",
  "homepage": "https://github.com/rafters-studio/mail/tree/main/packages/react-email#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/mail/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/mail.git",
    "directory": "packages/react-email"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "type": "module",
