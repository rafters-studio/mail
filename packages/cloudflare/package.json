{
  "name": "@rafters/mail-cloudflare",
  "version": "0.2.0",
  "description": "Receive and send mail for @rafters/mail on Cloudflare",
  "homepage": "https://github.com/rafters-studio/mail/tree/main/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/rafters-studio/mail/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafters-studio/mail.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vp test run --config vitest.config.ts",
    "test:watch": "vp test watch --config vitest.config.ts",
    "test:coverage": "vp test run --config vitest.config.ts --coverage",
    "test:workerd": "vp test run --config vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@rafters/mail": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:",
    "ws": "^8.18.3"
  }
}
